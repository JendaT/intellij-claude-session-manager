<idea-plugin>
    <id>com.github.jendalen.claudesessionmanager</id>
    <name>Claude Session Manager</name>
    <vendor email="jenda@dalen.cz" url="https://github.com/jendalen">Jenda Tresnak</vendor>

    <description><![CDATA[
        Persist Claude Code sessions across terminal tabs in JetBrains IDEs.

        Keep multiple Claude sessions organized - each terminal tab remembers its session.
        Sessions auto-resume when you restart the IDE.

        <b>Features:</b>
        <ul>
            <li>Bind sessions to tabs automatically or manually</li>
            <li>Auto-resume on IDE restart</li>
            <li>Session history per tab</li>
            <li>Detects /clear, /compact, /resume changes</li>
            <li>Agent Teams: team dashboard, teammate tabs, task tracking</li>
        </ul>

        <b>Setup:</b> After installation, go to Settings > Tools > Claude Session Manager
        and click "Install Hooks" to enable session detection.
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.6.1</h3>
        <ul>
            <li>Fixed: "Protect bound tab names" now works on the reworked terminal (2026.1).
                The reworked terminal applies Claude Code's title escape sequence without
                honoring the classic tracking flag, so protection is now enforced by clearing
                the application title whenever it reappears on a protected tab.</li>
            <li>Settings hint: the IDE-wide Advanced Setting "Show application title"
                (terminal.show.application.title) disables these titles for all tabs.</li>
        </ul>

        <h3>0.6.0</h3>
        <ul>
            <li>Fixed: Session bindings are no longer lost after IDE restart. The stable tab id
                lives in tab UserData and dies with the IDE process; bindings are now re-attached
                to restored tabs via the terminal-persisted tab name (the name the terminal plugin
                itself stores and restores, which Claude Code's title takeover never touches).</li>
            <li>Fixed: Auto-resume now waits for terminal tabs to finish restoring instead of
                declaring them missing after a fixed delay.</li>
            <li>New: "Protect bound tab names" setting (default on) - bound tabs ignore Claude
                Code's terminal-title escape sequence IDE-side, so custom tab names stay put
                without changing Claude Code settings.</li>
            <li>Improved: Bindings track the persisted tab name on user renames, keeping
                restart matching correct.</li>
        </ul>

        <h3>0.5.0</h3>
        <ul>
            <li>Fixed: Session bindings broke when Claude Code renamed terminal tabs (e.g. all tabs
                showing "Claude Code") on recent JetBrains builds. Tabs are now matched by a stable
                per-tab id instead of the volatile tab name, so renaming no longer loses bindings
                or causes cross-tab confusion.</li>
            <li>New: One-time, idempotent migration of existing bindings to the stable-id model.</li>
            <li>New: "Keep my custom tab names" setting that disables Claude Code's tab renaming
                (CLAUDE_CODE_DISABLE_TERMINAL_TITLE) for users who prefer their own names.</li>
        </ul>

        <h3>0.3.0</h3>
        <ul>
            <li>New: Agent Teams support - team dashboard, teammate terminal tabs</li>
            <li>New: Team member navigation (Ctrl+Alt+T), dashboard toggle (Ctrl+Alt+D)</li>
            <li>New: Task list and message log in team dashboard</li>
            <li>New: Agent Teams settings page</li>
        </ul>

        <h3>0.2.0</h3>
        <ul>
            <li>New: Hook integration manager in settings (install/revert with transparency)</li>
            <li>New: Settings action in context menu with "(action required)" indicator</li>
            <li>Improved: Coroutine lifecycle and thread safety</li>
            <li>Fixed: Memory leaks, date parsing, cache state issues</li>
        </ul>

        <h3>0.1.0</h3>
        <ul>
            <li>Initial release</li>
            <li>Basic session binding and management</li>
        </ul>
    ]]></change-notes>

    <!-- Platform and plugin dependencies -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- ===================== v1.0 Services ===================== -->

        <!-- Application-level services -->
        <applicationService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.SettingsService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.SettingsService"/>

        <applicationService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.ClaudeHookManager"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.ClaudeHookManager"/>

        <applicationService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.OptionAsMetaKeyGuardService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.OptionAsMetaKeyGuardService"/>

        <applicationService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.ClaudeTitleSettingsService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.ClaudeTitleSettingsService"/>

        <!-- Project-level services -->
        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.ClaudeSessionService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.ClaudeSessionService"/>

        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.BindingService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.BindingService"/>

        <!-- TabBindingCoordinator is a light service (@Service annotation) and must not be
             registered here as well - the platform rejects double registration. -->

        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.BindingMigrationService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.BindingMigrationService"/>

        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.SessionWatcherService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.SessionWatcherService"/>

        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.TerminalOutputMonitorService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.TerminalOutputMonitorService"/>

        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.services.ClaudeHookEventService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.services.ClaudeHookEventService"/>

        <!-- Settings UI -->
        <applicationConfigurable
            parentId="tools"
            instance="com.github.jendalen.claudesessionmanager.settings.PluginSettingsConfigurable"
            id="com.github.jendalen.claudesessionmanager.settings"
            displayName="Claude Session Manager"/>

        <!-- Notifications -->
        <notificationGroup id="ClaudeSessionManager" displayType="BALLOON"/>

        <!-- Auto-resume sessions on IDE startup -->
        <backgroundPostStartupActivity
            implementation="com.github.jendalen.claudesessionmanager.services.AutoResumeService"/>

        <!-- ===================== v2.0 Agent Teams ===================== -->

        <!-- Application-level services -->
        <applicationService
            serviceInterface="com.github.jendalen.claudesessionmanager.teams.services.TeamsSettingsService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.teams.services.TeamsSettingsService"/>

        <!-- Project-level services -->
        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.teams.services.TeamStateParser"
            serviceImplementation="com.github.jendalen.claudesessionmanager.teams.services.TeamStateParser"/>

        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.teams.services.FileSystemTeamWatcher"
            serviceImplementation="com.github.jendalen.claudesessionmanager.teams.services.FileSystemTeamWatcher"/>

        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.teams.services.AgentTeamsManager"
            serviceImplementation="com.github.jendalen.claudesessionmanager.teams.services.AgentTeamsManager"/>

        <projectService
            serviceInterface="com.github.jendalen.claudesessionmanager.teams.TeamNotificationService"
            serviceImplementation="com.github.jendalen.claudesessionmanager.teams.TeamNotificationService"/>

        <!-- Agent Teams settings (nested under Claude Session Manager) -->
        <applicationConfigurable
            parentId="com.github.jendalen.claudesessionmanager.settings"
            instance="com.github.jendalen.claudesessionmanager.teams.settings.TeamsSettingsConfigurable"
            id="com.github.jendalen.claudesessionmanager.teams.settings"
            displayName="Agent Teams"/>

        <!-- Team Dashboard tool window -->
        <toolWindow
            id="Claude Teams"
            anchor="right"
            secondary="true"
            icon="/icons/claude-teams.svg"
            factoryClass="com.github.jendalen.claudesessionmanager.teams.ui.TeamDashboardToolWindowFactory"/>

        <!-- Team watcher startup -->
        <backgroundPostStartupActivity
            implementation="com.github.jendalen.claudesessionmanager.teams.TeamWatcherStartupActivity"/>
    </extensions>

    <!-- Terminal plugin extensions -->
    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <openPredefinedTerminalProvider
            implementation="com.github.jendalen.claudesessionmanager.terminal.ClaudeSessionTerminalProvider"/>
    </extensions>

    <actions>
        <!-- ===================== v1.0 Actions ===================== -->

        <!-- Claude Session submenu in terminal tab context menu -->
        <group id="ClaudeSessionManager.TerminalPopup"
               text="Claude Session"
               description="Claude session management"
               popup="true">
            <add-to-group group-id="ToolWindowContextMenu" anchor="first"/>

            <action id="ClaudeSessionManager.CurrentSessionInfo"
                    class="com.github.jendalen.claudesessionmanager.actions.CurrentSessionInfoAction"
                    text="No session bound"
                    description="Current session info - click to copy session ID"/>

            <separator/>

            <action id="ClaudeSessionManager.BindSession"
                    class="com.github.jendalen.claudesessionmanager.actions.BindSessionAction"
                    text="Bind to Session..."
                    description="Bind a Claude session to this terminal tab"/>

            <action id="ClaudeSessionManager.ResumeSession"
                    class="com.github.jendalen.claudesessionmanager.actions.ResumeSessionAction"
                    text="Resume Session"
                    description="Resume the bound Claude session"/>

            <separator/>

            <group id="ClaudeSessionManager.SessionHistory"
                   class="com.github.jendalen.claudesessionmanager.actions.SessionHistoryAction"
                   text="Session History"
                   description="Previous sessions for this tab"
                   popup="true"/>

            <separator/>

            <action id="ClaudeSessionManager.CopySessionId"
                    class="com.github.jendalen.claudesessionmanager.actions.CopySessionIdAction"
                    text="Copy Session ID"
                    description="Copy the bound session ID to clipboard"/>

            <action id="ClaudeSessionManager.UnbindSession"
                    class="com.github.jendalen.claudesessionmanager.actions.UnbindSessionAction"
                    text="Unbind Session"
                    description="Remove Claude session binding from this tab"/>

            <separator/>

            <action id="ClaudeSessionManager.OpenSettings"
                    class="com.github.jendalen.claudesessionmanager.actions.OpenSettingsAction"
                    text="Settings..."
                    description="Open Claude Session Manager settings"/>
        </group>

        <!-- New Claude Session - available via Find Action, extension point handles dropdown -->
        <action id="ClaudeSessionManager.NewClaudeSession"
                class="com.github.jendalen.claudesessionmanager.actions.NewClaudeSessionAction"
                text="New Claude Session"
                description="Create a new terminal with a Claude session"/>

        <!-- ===================== v2.0 Agent Teams Actions ===================== -->

        <!-- Navigate to teammate popup picker -->
        <action id="ClaudeTeams.NavigateToTeammate"
                class="com.github.jendalen.claudesessionmanager.teams.actions.NavigateToTeammateAction"
                text="Navigate to Teammate..."
                description="Open a picker to navigate to a teammate's terminal tab">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt T"/>
        </action>

        <!-- Toggle dashboard -->
        <action id="ClaudeTeams.ToggleDashboard"
                class="com.github.jendalen.claudesessionmanager.teams.actions.ToggleDashboardAction"
                text="Toggle Team Dashboard"
                description="Show or hide the Claude Teams dashboard">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt D"/>
        </action>

        <!-- Navigate to team lead -->
        <action id="ClaudeTeams.NavigateToTeamLead"
                class="com.github.jendalen.claudesessionmanager.teams.actions.NavigateToTeamLeadAction"
                text="Navigate to Team Lead"
                description="Navigate to the team lead's terminal tab">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt 1"/>
        </action>

        <!-- Team context menu actions -->
        <group id="ClaudeTeams.TeammatePopup"
               class="com.github.jendalen.claudesessionmanager.teams.actions.TeamPopupActionGroup"
               text="Claude Team"
               description="Agent team actions"
               popup="true">
            <add-to-group group-id="ToolWindowContextMenu" anchor="after"
                          relative-to-action="ClaudeSessionManager.TerminalPopup"/>

            <reference ref="ClaudeTeams.ToggleDashboard"/>
            <reference ref="ClaudeTeams.NavigateToTeammate"/>
            <reference ref="ClaudeTeams.NavigateToTeamLead"/>
            <separator/>
            <action id="ClaudeTeams.CopyAgentId"
                    class="com.github.jendalen.claudesessionmanager.teams.actions.CopyAgentIdAction"
                    text="Copy Agent ID"
                    description="Copy the teammate's agent ID to clipboard"/>
        </group>
    </actions>
</idea-plugin>
